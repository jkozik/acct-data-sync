# Copy this file to .env and fill in real values. .env is git/docker-ignored --
# never commit real secrets.

# From https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SECRET_SANDBOX=

# sandbox | production -- only one should be uncommented at a time
PLAID_ENV=production
# PLAID_ENV=sandbox

# Comma-separated Plaid products this app requests, e.g. transactions,liabilities
PLAID_PRODUCTS=transactions

# Comma-separated ISO country codes
PLAID_COUNTRY_CODES=US

# Only needed for Plaid's OAuth redirect flow with certain institutions
PLAID_REDIRECT_URI=
